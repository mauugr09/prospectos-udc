# Copia este archivo como .env (junto a docker-compose.yml) y llénalo. NO lo subas a git.

# Dominio con el que todos van a entrar (sin https:// ni rutas). Pídelo a sistemas o cómpralo.
DOMINIO=prospectos.ejemplo.mx

# Cómo llega internet al servidor:
#   https  → el servidor tiene IP pública y puertos 80/443 abiertos (nube). Caddy saca el certificado.
#   tunel  → el servidor está detrás de un router o firewall (universidad, oficina). Cloudflare Tunnel.
COMPOSE_PROFILES=https

# Contraseñas de la base de datos: largas y únicas (por ejemplo: openssl rand -base64 30).
BD_CLAVE=
BD_CLAVE_ROOT=

# Primer administrador (solo se usa si todavía no hay usuarios). Al entrar, el programa pide cambiar la contraseña.
ADMIN_CORREO=
ADMIN_CLAVE=

# Solo con COMPOSE_PROFILES=tunel: el token del túnel (Cloudflare → Zero Trust → Networks → Tunnels).
# En el túnel, el «Public hostname» = DOMINIO y el servicio = http://app:8000
TUNEL_TOKEN=
